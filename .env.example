# Copie para .env (o arquivo .env NÃO vai para o Git)
# PIN do Admin — também há fallback no código do Admin
VITE_ADMIN_PIN=

# PIN do gate (Erros + Mapa do Site) — separado da Gestão; fallback no código
VITE_GATE_PIN=

# Repo alvo da publicação (não são segredos)
VITE_GITHUB_OWNER=andressabarrakreia-arch
VITE_GITHUB_REPO=belloscar-leads
VITE_GITHUB_DATA_PATH=public/data/dataset.json
VITE_GITHUB_BRANCH=main

# NUNCA coloque GITHUB_PAT / tokens aqui nem com prefixo VITE_
# Token de publicação: salve uma vez no Admin (localStorage do navegador)
